# Copy to one file per namespace on the OliveTin host:
#
#   /etc/teiwah/session-cleanup/sandbox.env
#   /etc/teiwah/session-cleanup/default.env
#
# These files intentionally live outside git because they contain DB and Zuplo
# secrets. The cleanup scripts refuse to run if CLEANUP_NAMESPACE does not match
# the selected OliveTin namespace.

# sandbox or default
CLEANUP_NAMESPACE=sandbox

# Dev DB for sandbox, prod DB for default.
DATABASE_URL=postgresql://...

# Zuplo Developer API credentials for the matching environment/key bucket.
ZUPLO_API_BASE=https://dev.zuplo.com/v1
ZUPLO_API_KEY=...
ZUPLO_ACCOUNT=...
ZUPLO_KEY_BUCKET=...
