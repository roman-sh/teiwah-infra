# Copy to hetzner/.env (gitignored). Used by create-test-worker.sh
HCLOUD_TOKEN=
# Master's teiwah-private IP — reachable from any VM on the network. Public IP also works.
K3S_URL=https://10.0.0.2:6443
# From teiwah-master: /var/lib/rancher/k3s/server/node-token
K3S_TOKEN=
# Match existing nodes (e.g. hel1, nbg1)
LOCATION=hel1
SERVER_TYPE=cpx22
WORKER_NAME=teiwah-worker-test-1
# Existing Hetzner private network (hcloud network list)
NETWORK_NAME=teiwah-private
