# Grafana Cloud Prometheus (remote_write) credentials — copy to secret.env and fill in.
# secret.env is gitignored. Get these from Grafana Cloud → Connections → Prometheus /
# "Send Metrics": the push URL, your instance/stack ID (username), and a write-scoped token.

# Full remote_write endpoint, e.g.
#   https://prometheus-prod-XX-prod-eu-west-0.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_URL=

# Numeric instance ID shown next to the push URL.
GRAFANA_CLOUD_USERNAME=

# A Grafana Cloud Access Policy token with metrics:write scope.
GRAFANA_CLOUD_API_KEY=
