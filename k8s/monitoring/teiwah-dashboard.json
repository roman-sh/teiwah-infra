{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Your Grafana Cloud Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["teiwah"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Teiwah — Capacity & Session Memory",
  "uid": "teiwah-capacity",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Live sessions",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(container_memory_working_set_bytes{namespace=\"default\", container=\"wa-session\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg / session (range)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg(avg_over_time(container_memory_working_set_bytes{namespace=\"default\", container=\"wa-session\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Peak / session (range)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "orange" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(max_over_time(container_memory_working_set_bytes{namespace=\"default\", container=\"wa-session\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Suggested request (p95 +10%)",
      "description": "P95 of per-session peak, +10% headroom. Candidate value for the memory request in teiwah-control (k8s.service.ts).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "quantile(0.95, max_over_time(container_memory_working_set_bytes{namespace=\"default\", container=\"wa-session\"}[$__range])) * 1.1",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Sessions — memory per session (avg / peak / p95 over selected range)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 13, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "decimals": 0, "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Session" },
            "properties": [
              { "id": "unit", "value": "string" },
              { "id": "custom.width", "value": 320 },
              { "id": "mappings", "value": [ { "type": "regex", "options": { "pattern": "^(.*)-[^-]+-[^-]+$", "result": { "text": "$1" } } } ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Node" },
            "properties": [ { "id": "unit", "value": "string" }, { "id": "custom.width", "value": 150 } ]
          },
          {
            "matcher": { "id": "byName", "options": "Peak/Limit" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.8 },
                    { "color": "red", "value": 0.95 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Peak", "desc": true } ]
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "format": "table", "instant": true, "expr": "avg by (pod) (avg_over_time(container_memory_working_set_bytes{namespace=\"default\", container=\"wa-session\"}[$__range]))" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "format": "table", "instant": true, "expr": "max by (pod) (max_over_time(container_memory_working_set_bytes{namespace=\"default\", container=\"wa-session\"}[$__range]))" },
        { "refId": "F", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "format": "table", "instant": true, "expr": "max by (pod) (kube_pod_container_resource_limits{namespace=\"default\", container=\"wa-session\", resource=\"memory\"})" },
        { "refId": "G", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "format": "table", "instant": true, "expr": "max by (pod, node) (kube_pod_container_resource_requests{namespace=\"default\", container=\"wa-session\", resource=\"memory\"})" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "pod", "mode": "outer" } },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": { "left": "Value #B", "operator": "/", "right": "Value #F" },
            "alias": "Peak/Limit",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Value #F": true, "Value #G": true },
            "renameByName": {
              "pod": "Session",
              "node": "Node",
              "Value #A": "Avg",
              "Value #B": "Peak"
            },
            "indexByName": {
              "pod": 0,
              "node": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Peak/Limit": 4
            }
          }
        }
      ]
    }
  ]
}
